# Copy this file to .env and fill in your key:
#   cp .env.example .env

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=interview_bank

# Anthropic doesn't serve its own embedding model - Voyage AI is its
# recommended embeddings partner. Free tier is plenty for this project.
# Get a key at https://www.voyageai.com
VOYAGE_API_KEY=your-voyage-key-here
VOYAGE_MODEL=voyage-3.5

# Claude's API has no audio input - transcription for the audio interview
# feature goes through OpenAI's transcription endpoint instead.
# Get a key at https://platform.openai.com
OPENAI_API_KEY=your-openai-key-here
STT_MODEL=gpt-4o-mini-transcribe

# Text-to-speech for reading interview questions aloud (same OpenAI key as above)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Database - SQLite file, created automatically on first run
DATABASE_URL=sqlite:///./careerpilot.db

# JWT auth secret - generate a real one, don't use the default below:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-this-before-deploying-anywhere
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Used to build links inside verification/password-reset emails
FRONTEND_URL=http://localhost:3000

# Email - leave SMTP_USERNAME blank to run in dev mode (emails print to
# this terminal instead of sending, so the feature works with zero setup).
# For real delivery via Gmail: turn on 2-Step Verification, then generate
# an App Password at https://myaccount.google.com/apppasswords - use THAT
# here, never your real account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated list is NOT supported here since this maps to a list field;
# edit config.py's default or override via a proper .env array if you deploy
# multiple frontend origins.
